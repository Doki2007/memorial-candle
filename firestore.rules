rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /candles/{candleId} {

      // Cualquier usuario (incluso anónimo) puede leer
      allow read: if true;

      // Solo puede crear si está autenticado y los datos son válidos
      allow create: if request.auth != null
        && request.resource.data.name    is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 600
        && request.resource.data.x is number
        && request.resource.data.x >= 0
        && request.resource.data.x <= 100
        && request.resource.data.y is number
        && request.resource.data.y >= 0
        && request.resource.data.y <= 100;

      // Nadie puede editar ni borrar velas
      allow update, delete: if false;
    }
  }
}
